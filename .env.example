# Copy to .env and fill in what you need. .env is git-ignored. Never commit credentials.

# Apple Developer team ID. When set, builds are signed with your Apple Development certificate,
# so Accessibility and Keychain access survive rebuilds. Leave empty for ad-hoc signing.
DEVELOPMENT_TEAM=

# Release packaging only (make release / make dmg). Use your Developer ID Application identity name
# or SHA-1 fingerprint. Keep the same team for every release so Accessibility access survives updates.
APPLE_SIGNING_IDENTITY=
# make dmg notarizes with a profile saved by: xcrun notarytool store-credentials <name>
NOTARY_KEYCHAIN_PROFILE=
